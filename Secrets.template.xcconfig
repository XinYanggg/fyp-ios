// Copy this file to Secrets.xcconfig (git-ignored) and fill in the values.
// Both Debug and Release builds read Secrets.xcconfig.
//
// xcconfig treats "//" as a comment, so URLs can't be written directly.
// Use the $(SLASH) trick below.
SLASH = /

// Deployed backend, used by Release builds. No trailing slash.
// Debug builds always use http://localhost:3000.
API_BASE_URL = https:$(SLASH)$(SLASH)your-site.example.com

// Google Sign-In
// Web client ID: same as GOOGLE_CLIENT_ID on the website (the backend checks the token audience against it).
GOOGLE_WEB_CLIENT_ID = 1234567890-webclient.apps.googleusercontent.com
// iOS client ID without the ".apps.googleusercontent.com" suffix, e.g. 1234567890-abcdefg
// Create it in Google Cloud Console: Credentials > Create OAuth client ID > iOS, bundle ID com.farnxinyang.durian-health
// Leave empty to hide the Google button.
GOOGLE_IOS_CLIENT_ID_PREFIX =
GOOGLE_IOS_CLIENT_ID = $(GOOGLE_IOS_CLIENT_ID_PREFIX).apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID = com.googleusercontent.apps.$(GOOGLE_IOS_CLIENT_ID_PREFIX)
